DISCORD_TOKEN=
CLIENT_ID=
# GUILD_ID เป็นตัวเลือก: ใส่ไว้ตอนพัฒนาเพื่อให้ slash command อัปเดตทันที
# ถ้าไม่ใส่ คำสั่งจะลงทะเบียนแบบ global (ใช้เวลาเผยแพร่นานสุด ~1 ชั่วโมง)
GUILD_ID=

# --- เว็บแดชบอร์ด ---
# รหัสผ่านสำหรับเข้าหน้าควบคุมบอท (ตั้งเอง ห้ามใช้ค่าเดา/ค่าเริ่มต้น) — ถ้าไม่ตั้งค่านี้ แดชบอร์ดจะไม่เปิดให้ใช้งาน
DASHBOARD_PASSWORD=
# สตริงสุ่มไว้เข้ารหัส session — สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# path ไฟล์ฐานข้อมูล SQLite — บน Railway ให้ชี้เข้า Volume ที่ mount ไว้ เช่น /data/bot.sqlite
DB_PATH=
# พอร์ตที่เว็บแดชบอร์ดรัน (Railway จะตั้งค่านี้ให้อัตโนมัติ ไม่ต้องใส่เองบน Railway)
PORT=3000

# --- PO Token provider (ไม่บังคับ) ---
# URL ของ bgutil POT provider server สำหรับช่วยผ่านการตรวจ "ยืนยันว่าไม่ใช่บอท" ของ YouTube
# เว้นว่างไว้ได้ถ้าไม่ได้รัน provider (บอทจะทำงานปกติ แค่ไม่มี token ช่วย)
POT_BASE_URL=

# --- Proxy (ไม่บังคับ แต่จำเป็นถ้า host โดน YouTube บล็อก IP) ---
# ถ้า YouTube ขึ้น "Sign in to confirm you're not a bot" กับแทบทุกวิดีโอ แปลว่า IP ของเซิร์ฟเวอร์โดนแฟลก
# ใส่ proxy (แนะนำ residential proxy) เช่น http://user:pass@host:port เพื่อให้ traffic ออกทาง IP ที่สะอาด
YTDLP_PROXY=

# --- YouTube cookies (ไม่บังคับ) ---
# บางวิดีโอ (มักเป็นเพลงทางการ/ค่ายเพลงใหญ่) YouTube บังคับให้ยืนยันตัวตนก่อนถึงจะเล่นได้
# ถ้าเจอ error "Sign in to confirm you're not a bot" ให้ export คุกกี้จากเบราว์เซอร์ (แนะนำใช้บัญชี Google สำรอง ไม่ใช่บัญชีหลัก)
# ด้วยส่วนขยาย "Get cookies.txt LOCALLY" แล้ววางเนื้อหาไฟล์ทั้งหมด (Netscape format) ลงในค่านี้
YOUTUBE_COOKIES=
